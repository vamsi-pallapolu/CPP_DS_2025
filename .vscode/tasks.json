{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/bin/bash",
            "args": [
                "-c",
                "mkdir -p '${workspaceFolder}/derived/${relativeFileDirname}' && /usr/bin/clang++ -fcolor-diagnostics -fansi-escape-codes -std=gnu++17 -g '${file}' -o '${workspaceFolder}/derived/${relativeFileDirname}/${fileBasenameNoExtension}'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "detail": "Compile with clang++ into derived/ (used by the Run C/C++ File button)."
        },
        {
            "type": "shell",
            "label": "C/C++: MSVC build active file (Windows)",
            "command": "cmd.exe",
            "args": [
                "/c",
                "if not exist \"${workspaceFolder}\\derived\\${relativeFileDirname}\" mkdir \"${workspaceFolder}\\derived\\${relativeFileDirname}\" && cl.exe /nologo /std:c++17 /EHsc /Zi /Fd\"${workspaceFolder}\\derived\\${relativeFileDirname}\\${fileBasenameNoExtension}.pdb\" /Fe\"${workspaceFolder}\\derived\\${relativeFileDirname}\\${fileBasenameNoExtension}.exe\" \"${file}\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "detail": "Windows/MSVC: compile the active file with cl.exe into derived/."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}